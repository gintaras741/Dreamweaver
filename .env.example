# Copy to .env (make setup does it for you) and change the secrets.
# Don't use $ or # in values, make can't handle them.
# Jwt__Secret becomes Jwt:Secret in .NET config.

# PostgreSQL
POSTGRES_DB=dreamweaver
POSTGRES_USER=dreamweaver
POSTGRES_PASSWORD=dreamweaver_dev_password
POSTGRES_PORT=5432

# API
ConnectionStrings__Default=Host=localhost;Port=5432;Database=dreamweaver;Username=dreamweaver;Password=dreamweaver_dev_password

# Run migrations on startup (used in docker, locally just run make migrate)
Database__MigrateOnStartup=false

# JWT, secret needs to be 32+ bytes (openssl rand -base64 48)
Jwt__Issuer=dreamweaver
Jwt__Audience=dreamweaver
Jwt__Secret=dev-only-secret-change-me-0123456789-abcdefghijklmnop

# Seed data, only runs when the database has no users
Seed__Enabled=true
Seed__AdminPassword=Admin12345
Seed__MiraPassword=Mira12345
Seed__TomasPassword=Tomas12345
